{
    "name": "NewsJS",
    "version": "1.0.0",
    "description": "News portal built with TypeScript and Webpack on top of News API",
    "main": "webpack.base.config.js",
    "scripts": {
        "start": "webpack serve --open --config ./webpack.config.js --env mode=dev",
        "build": "webpack --config ./webpack.config.js --env mode=prod",
        "lint": "eslint . --ext .ts",
        "typecheck": "tsc --noEmit",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/andreyfits/news-JS.git"
    },
    "keywords": [],
    "author": "Aleh Serhiyenia",
    "license": "ISC",
    "homepage": "https://andreyfits.github.io/news-JS/",
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "clean-webpack-plugin": "^4.0.0",
        "copy-webpack-plugin": "^12.0.2",
        "css-loader": "^6.11.0",
        "dotenv-webpack": "^8.1.1",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.7",
        "gh-pages": "^6.3.0",
        "html-webpack-plugin": "^5.6.8",
        "prettier": "3.2.5",
        "style-loader": "^3.3.4",
        "ts-loader": "^9.6.2",
        "typescript": "^5.9.3",
        "webpack": "^5.112.2",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.2.7",
        "webpack-merge": "^5.10.0"
    }
}
